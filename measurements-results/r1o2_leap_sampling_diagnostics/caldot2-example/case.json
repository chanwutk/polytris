  "selection_sql": "WITH errors AS (\n SELECT o.*,greatest(0,least(o.x2,o.px2)-greatest(o.x1,o.px1))*\n   greatest(0,least(o.y2,o.py2)-greatest(o.y1,o.py1)) inter,\n   (o.x2-o.x1)*(o.y2-o.y1)+(o.px2-o.px1)*(o.py2-o.py1) total\n FROM oracle_boxes o\n JOIN matches m0 ON o.video=m0.video AND o.id=m0.gt_id AND o.s=m0.frame\n JOIN matches m1 ON o.video=m1.video AND o.id=m1.gt_id AND o.e=m1.frame\n WHERE m0.iou>=0.75 AND m1.iou>=0.75 AND o.e-o.s BETWEEN 30 AND 90\n   AND o.frame=round((o.s+o.e)/2) AND o.x2-o.x1>=15)\n SELECT video,id,s,e,frame,x1,y1,x2,y2,px1,py1,px2,py2,inter/nullif(total-inter,0) midpoint_iou\n FROM errors ORDER BY midpoint_iou,video,id LIMIT 1",
  "quality_check": {
    "maximum_native_frame_center_step_in_box_diagonals": 0.3893655154057123,
    "endpoint_requirement": "Both sampled endpoint detections matched annotation IoU >= 0.75",
